doctype html
html
  head
    meta(name='viewport', content='width=device-width')
    meta(http-equiv='Content-Type', content='text/html; charset=UTF-8')
    title= subject

  body(style='font-family: Arial, sans-serif; background:#f6f9fc; padding:40px;')
    div(style='max-width:600px; margin:auto; background:white; padding:40px; border-radius:10px;')
      
      h1 Welcome to Natours, #{firstName}! 👋

      p
        | We're excited to have you with us.

      p
        | You can now explore tours, manage your profile, and start your adventure.

      a(
        href=url
        style='display:inline-block; padding:12px 24px; background:#55c57a; color:white; text-decoration:none; border-radius:5px;'
      ) Go to your profile

      p(style='margin-top:30px;')
        | See you there!

      p
        | The Natours Team