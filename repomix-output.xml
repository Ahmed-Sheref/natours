exports.get_plan_monthly = async (req , res) =>
{
    try
    {
        let year = req.params.year;
        let Tours = await Tour.aggregate(
            [
                {
                    '$unwind' : '$startDates'
                },
                {
                    '$match' : 
                    {
                        startDates : 
                        {
                            '$gte' : new Date(`${year}-01-01`),
                            '$lte' : new Date(`${year}-12-31`)
                        }
                    }
                }
                ,
                {
                    '$group' : 
                    {
                        _id : {'$month' : '$startDates'},
                        numOfTours : {'$sum' : 1},
                        Tours : {'$push' : '$name'}
                    }
                }
                ,
                {
                    '$project' :
                    {
                        _id: 0,
                        month: "$_id",
                        numOfTours: 1,
                        Tours: 1
                    }
                }
            ]
        )

        res.status(200).json(
            {
                len : Tours.length,
                status : 'success',
                data: Tours
            }
        )
    }
    catch (err)
    {
        res.status(400).json(
        {
            status: 'fail',
            message: `Invalid ID: ${err.message}`
        });
    }
}
